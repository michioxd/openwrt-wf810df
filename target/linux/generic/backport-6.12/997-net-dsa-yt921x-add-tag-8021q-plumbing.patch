 }
 
+/* ---- tag_8021q mode ----------------------------------------------------
+ *
+ * The CPU port speaks plain 802.1Q instead of the YT921X tag: no tag in
+ * either direction, the port is a tagged member of every tag_8021q VLAN and
+ * frames from the host are forwarded by the VLAN table. A user port is an
+ * untagged member of its tag_8021q VLAN, takes it as PVID, and has ingress
+ * filtering on so a tagged frame can only enter a VLAN it is a member of.
+ *
+ * These helpers run under priv->reg_lock.
+ */
+
+static int yt921x_vlan_add(struct yt921x_priv *priv, int port, u16 vid,
+			   bool untagged);
+static int yt921x_vlan_del(struct yt921x_priv *priv, int port, u16 vid);
+
+static int yt921x_8021q_cpu_port_enter(struct yt921x_priv *priv, int port)
+{
+	u32 ctrl;
+	int res;
+
+	/* No CPU tag in either direction; the VLAN table steers frames. */
+	res = yt921x_reg_clear_bits(priv, YT921X_EXT_CPU_PORT,
+				    YT921X_EXT_CPU_PORT_TAG_EN);
+	if (res)
+		return res;
+
+	res = yt921x_vlan_aware_set(priv, port, true);
+	if (res)
+		return res;
+
+	res = yt921x_port_set_pvid(priv, port, YT921X_VID_UNAWARE);
+	if (res)
+		return res;
+
+	res = yt921x_reg_toggle_bits(priv, YT921X_VLAN_IGR_FILTER,
+				     YT921X_VLAN_IGR_FILTER_PORTn(port), true);
+	if (res)
+		return res;
+
+	/* Tag-directed forwarding blocked every destination here; VLAN
+	 * forwarding needs them open (membership narrows it down).
+	 */
+	res = yt921x_reg_write(priv, YT921X_PORTn_ISOLATION(port), 0);
+	if (res)
+		return res;
+
+	/* Frames from the host to a MAC the switch has not learned yet must
+	 * flood: the bridge sends a single copy in the bridge VID.
+	 */
+	res = yt921x_reg_read(priv, YT921X_ACT_UNK_UCAST, &ctrl);
+	if (res)
+		return res;
+	ctrl &= ~YT921X_ACT_UNK_ACTn_M(port);
+	ctrl |= YT921X_ACT_UNK_ACTn_FORWARD(port);
+	res = yt921x_reg_write(priv, YT921X_ACT_UNK_UCAST, ctrl);
+	if (res)
+		return res;
+
+	res = yt921x_reg_read(priv, YT921X_ACT_UNK_MCAST, &ctrl);
+	if (res)
+		return res;
+	ctrl &= ~YT921X_ACT_UNK_ACTn_M(port);
+	ctrl |= YT921X_ACT_UNK_ACTn_FORWARD(port);
+
+	return yt921x_reg_write(priv, YT921X_ACT_UNK_MCAST, ctrl);
+}
+
+static int yt921x_8021q_cpu_port_leave(struct yt921x_priv *priv, int port)
+{
+	u32 ctrl;
+	int res;
+
+	/* Back to tag-directed forwarding: the tag stays on the conduit,
+	 * the CPU port takes no VLAN decision, nothing is flooded out of it.
+	 */
+	res = yt921x_reg_set_bits(priv, YT921X_EXT_CPU_PORT,
+				  YT921X_EXT_CPU_PORT_TAG_EN);
+	if (res)
+		return res;
+
+	res = yt921x_reg_write(priv, YT921X_PORTn_ISOLATION(port),
+			       GENMASK(YT921X_PORT_NUM - 1, 0));
+	if (res)
+		return res;
+
+	res = yt921x_reg_read(priv, YT921X_ACT_UNK_UCAST, &ctrl);
+	if (res)
+		return res;
+	ctrl &= ~YT921X_ACT_UNK_ACTn_M(port);
+	ctrl |= YT921X_ACT_UNK_ACTn_DROP(port);
+	res = yt921x_reg_write(priv, YT921X_ACT_UNK_UCAST, ctrl);
+	if (res)
+		return res;
+
+	res = yt921x_reg_read(priv, YT921X_ACT_UNK_MCAST, &ctrl);
+	if (res)
+		return res;
+	ctrl &= ~YT921X_ACT_UNK_ACTn_M(port);
+	ctrl |= YT921X_ACT_UNK_ACTn_DROP(port);
+	res = yt921x_reg_write(priv, YT921X_ACT_UNK_MCAST, ctrl);
+	if (res)
+		return res;
+
+	res = yt921x_vlan_aware_set(priv, port, false);
+	if (res)
+		return res;
+
+	res = yt921x_port_set_pvid(priv, port, YT921X_VID_UNAWARE);
+	if (res)
+		return res;
+
+	return yt921x_reg_toggle_bits(priv, YT921X_VLAN_IGR_FILTER,
+				      YT921X_VLAN_IGR_FILTER_PORTn(port), false);
+}
+
+static int yt921x_8021q_user_port_enter(struct yt921x_priv *priv, int port)
+{
+	u16 pvid = priv->tag_8021q_pvid[port];
+	int res;
+
+	res = yt921x_vlan_aware_set(priv, port, true);
+	if (res)
+		return res;
+
+	res = yt921x_port_set_pvid(priv, port, pvid ? : YT921X_VID_UNAWARE);
+	if (res)
+		return res;
+
+	/* Untagged frames take the PVID, tagged ones must be in the table. */
+	res = yt921x_reg_clear_bits(priv, YT921X_PORTn_VLAN_CTRL1(port),
+				    YT921X_PORT_VLAN_CTRL1_CVLAN_DROP_UNTAGGED |
+				    YT921X_PORT_VLAN_CTRL1_CVLAN_DROP_TAGGED);
+	if (res)
+		return res;
+
+	return yt921x_reg_toggle_bits(priv, YT921X_VLAN_IGR_FILTER,
+				      YT921X_VLAN_IGR_FILTER_PORTn(port), true);
+}
+
+int yt921x_8021q_port_enter(struct yt921x_priv *priv, int port)
+{
+	if (dsa_is_cpu_port(&priv->ds, port))
+		return yt921x_8021q_cpu_port_enter(priv, port);
+
+	return yt921x_8021q_user_port_enter(priv, port);
+}
+
+void yt921x_8021q_port_leave(struct yt921x_priv *priv, int port)
+{
+	priv->tag_8021q_pvid[port] = 0;
+
+	if (dsa_is_cpu_port(&priv->ds, port)) {
+		yt921x_8021q_cpu_port_leave(priv, port);
+		return;
+	}
+
+	yt921x_vlan_aware_set(priv, port, false);
+	yt921x_port_set_pvid(priv, port, YT921X_VID_UNAWARE);
+	yt921x_reg_toggle_bits(priv, YT921X_VLAN_IGR_FILTER,
+			       YT921X_VLAN_IGR_FILTER_PORTn(port), false);
+}
+
+/* Apply the mode to the user ports at runtime; at boot port_setup() does it.
+ * A port that is already in a VLAN-unaware bridge had its standalone VID
+ * installed by the tag_8021q registration and the bridge VID has to take
+ * its place, as it would have at bridge join time.
+ */
+int yt921x_8021q_user_ports_enter(struct yt921x_priv *priv)
+{
+	struct dsa_switch *ds = &priv->ds;
+	struct dsa_port *dp;
+	int res;
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		mutex_lock(&priv->reg_lock);
+		res = yt921x_8021q_user_port_enter(priv, dp->index);
+		mutex_unlock(&priv->reg_lock);
+		if (res)
+			return res;
+
+		if (dp->bridge && !br_vlan_enabled(dp->bridge->dev)) {
+			bool tx_fwd_offload;
+
+			res = dsa_tag_8021q_bridge_join(ds, dp->index,
+							*dp->bridge,
+							&tx_fwd_offload, NULL);
+			if (res)
+				return res;
+		}
+	}
+
+	return 0;
+}
+
+int yt921x_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+			      u16 flags)
+{
+	struct yt921x_priv *priv = yt921x_to_priv(ds);
+	bool untagged = flags & BRIDGE_VLAN_INFO_UNTAGGED;
+	bool pvid = flags & BRIDGE_VLAN_INFO_PVID;
+	int res;
+
+	mutex_lock(&priv->reg_lock);
+	res = yt921x_vlan_add(priv, port, vid, untagged);
+	if (!res && pvid && dsa_is_user_port(ds, port)) {
+		res = yt921x_port_set_pvid(priv, port, vid);
+		if (!res)
+			priv->tag_8021q_pvid[port] = vid;
+	}
+	mutex_unlock(&priv->reg_lock);
+
+	return res;
+}
+
+int yt921x_tag_8021q_vlan_del(struct dsa_switch *ds, int port, u16 vid)
+{
+	struct yt921x_priv *priv = yt921x_to_priv(ds);
+	int res;
+
+	mutex_lock(&priv->reg_lock);
+	res = yt921x_vlan_del(priv, port, vid);
+	if (!res && priv->tag_8021q_pvid[port] == vid) {
+		priv->tag_8021q_pvid[port] = 0;
+		res = yt921x_port_set_pvid(priv, port, YT921X_VID_UNAWARE);
+	}
+	mutex_unlock(&priv->reg_lock);
+
+	return res;
+}
+
+static int yt921x_8021q_standalone(struct yt921x_priv *priv, int port)
+{
+	u32 mask;
+	int res;
+
+	res = yt921x_port_isolation_set(priv, port,
+					yt921x_non_cpu_port_mask(priv));
+	if (res)
+		return res;
+
+	mask = YT921X_PORT_LEARN_DIS;
+
+	return yt921x_reg_set_bits(priv, YT921X_PORTn_LEARN(port), mask);
+}
+
+/* Called with the conduit down, from the device tree or through
+ * /sys/class/net/<conduit>/dsa/tagging.
+ */
+int yt921x_change_tag_protocol(struct dsa_switch *ds, enum dsa_tag_protocol proto)
+{
+	struct yt921x_priv *priv = yt921x_to_priv(ds);
+	struct dsa_port *dp;
+	int res;
+
+	switch (proto) {
+	case DSA_TAG_PROTO_YT921X:
+		if (!priv->tag_8021q)
+			return 0;
+
+		dsa_tag_8021q_unregister(ds);
+		priv->tag_8021q = false;
+
+		dsa_switch_for_each_user_port(dp, ds) {
+			mutex_lock(&priv->reg_lock);
+			yt921x_8021q_port_leave(priv, dp->index);
+			mutex_unlock(&priv->reg_lock);
+		}
+
+		mutex_lock(&priv->reg_lock);
+		res = yt921x_8021q_cpu_port_leave(priv,
+						  priv->primary_cpu_port);
+		mutex_unlock(&priv->reg_lock);
+		return res;
+
+	case DSA_TAG_PROTO_YT921X_8021Q:
+		if (priv->tag_8021q)
+			return 0;
+
+		mutex_lock(&priv->reg_lock);
+		res = yt921x_8021q_cpu_port_enter(priv, priv->primary_cpu_port);
+		mutex_unlock(&priv->reg_lock);
+		if (res)
+			return res;
+
+		priv->tag_8021q = true;
+		res = dsa_tag_8021q_register(ds, htons(ETH_P_8021Q));
+		if (res) {
+			priv->tag_8021q = false;
+			mutex_lock(&priv->reg_lock);
+			yt921x_8021q_cpu_port_leave(priv,
+						    priv->primary_cpu_port);
+			mutex_unlock(&priv->reg_lock);
+			return res;
+		}
+
+		return yt921x_8021q_user_ports_enter(priv);
+
+	default:
+		return -EPROTONOSUPPORT;
+	}
+}
+
 static int
 yt921x_vlan_del(struct yt921x_priv *priv, int port, u16 vid)
 {
@@ -960,6 +1306,12 @@
 	if (dsa_is_cpu_port(ds, port))
 		return 0;
 
+	if (priv->tag_8021q) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "VLAN filtering is not available with the yt921x-8021q tagger");
+		return -EOPNOTSUPP;
+	}
+
 	mutex_lock(&priv->reg_lock);
 	do {
 		res = yt921x_vlan_filtering(priv, port, vlan_filtering);
@@ -989,6 +1341,9 @@
 	u16 pvid = 0;
 	int res;
 
+	if (priv->tag_8021q)
+		return -EOPNOTSUPP;
+
 	mutex_lock(&priv->reg_lock);
 	do {
 		res = yt921x_vlan_del(priv, port, vid);
@@ -1026,6 +1381,12 @@
 	u16 pvid = 0;
 	int res;
 
+	if (priv->tag_8021q) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "bridge VLANs are not available with the yt921x-8021q tagger");
+		return -EOPNOTSUPP;
+	}
+
 	mutex_lock(&priv->reg_lock);
 	do {
 		res = yt921x_vlan_add(priv, port, vid,
@@ -1566,8 +1927,17 @@
 	if (dsa_is_cpu_port(ds, port))
 		return;
 
+	/* 8021q mode: the port trades the bridge's VID for its standalone one
+	 * before the isolation is narrowed down again.
+	 */
