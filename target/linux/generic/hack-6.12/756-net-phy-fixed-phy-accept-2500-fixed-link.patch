Subject: [PATCH] net: phy: preserve 2500 fixed-link speed after status reads

The software PHY uses 1000M Clause 22 registers to represent a 2500M
fixed link. Restore its configured speed after generic status decoding,
including after a stop/start cycle. Only pseudo fixed PHYs advertising
2500baseX are affected; real PHY negotiation remains unchanged.

---
--- a/drivers/net/phy/fixed_phy.c
+++ b/drivers/net/phy/fixed_phy.c
@@ -274,6 +274,12 @@
 	phy->is_pseudo_fixed_link = true;
 
 	switch (status->speed) {
+	case SPEED_2500:
+		linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+				 phy->supported);
+		linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseX_Full_BIT,
+				 phy->supported);
+		fallthrough;
 	case SPEED_1000:
 		linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Half_BIT,
 				 phy->supported);
--- a/drivers/net/phy/swphy.c
+++ b/drivers/net/phy/swphy.c
@@ -71,6 +71,11 @@
 static int swphy_decode_speed(int speed)
 {
 	switch (speed) {
+	/*
+	 * Clause 22 software PHY has no dedicated 2.5G status bits.
+	 * Accept 2500 fixed-link and represent it using 1000M C22 encoding.
+	 */
+	case SPEED_2500:
 	case 1000:
 		return SWMII_SPEED_1000;
 	case 100:
--- a/drivers/net/phy/phy_device.c
+++ b/drivers/net/phy/phy_device.c
@@ -2757,3 +2757,9 @@ int genphy_read_status(struct phy_device *phydev)
+	/* Clause 22 emulation encodes a 2500M fixed link as 1000M. */
+	if (phydev->is_pseudo_fixed_link && phydev->speed == SPEED_1000 &&
+	    linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseX_Full_BIT,
+			      phydev->supported))
+		phydev->speed = SPEED_2500;
+
 	return 0;
 }
 EXPORT_SYMBOL(genphy_read_status);
