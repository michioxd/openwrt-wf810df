/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "FPT AX3000CV2";
	compatible ="fpt,ax3000cv2", "qcom,ipq5018";
	
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		
		nss@40000000 {
			no-map;
			reg = <0x0 0x40000000 0x0 0x1000000>;
		};
		
		smem@4ab00000 {
			no-map;
			reg = <0x0 0x4ab00000 0x0 0x100000>;
			phandle = <&smem>;
		};
		
		tz@4ac00000 {
			no-map;
			reg = <0x0 0x4ac00000 0x0 0x400000>;
		};
		
		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
			reg = <0x0 0x4b000000 0x0 0x3500000>;
		};
		
		q6_ipq5018_data: q6_ipq5018_data@4c000000 {
			no-map;
			reg = <0x0 0x4c000000 0x0 0xd00000>;
		};
		
		m3_dump@4cd00000 {
			no-map;
			reg = <0x0 0x4cd00000 0x0 0x100000>;
		};
		
		q6_etr_dump: q6_etr_dump@4ce00000 {
			no-map;
			reg = <0x0 0x4ce00000 0x0 0x100000>;
		};
		
		q6_caldb_region: q6_caldb_region@4cf00000 {
			no-map;
			reg = <0x0 0x4cf00000 0x0 0x200000>;
		};
		
		q6_qcn6122_data1: q6_qcn6122_data1@4d100000 {
			no-map;
			reg = <0x0 0x4d100000 0x0 0xd00000>;
		};
		
		m3_dump_qcn6122_1: m3_dump_qcn6122_1@4de00000 {
			no-map;
			reg = <0x0 0x4de00000 0x0 0x100000>;
		};
		
		q6_qcn6122_etr_1: q6_qcn6122_etr_1@4df00000 {
			no-map;
			reg = <0x0 0x4df00000 0x0 0x100000>;
		};
		
		q6_qcn6122_caldb_1: q6_qcn6122_caldb_1@4e000000 {
			no-map;
			reg = <0x0 0x4e000000 0x0 0x500000>;
		};
		
		ramoops@4e500000 {
			compatible = "ramoops";
			no-map;
			reg = <0x0 0x4e500000 0x0 0x140000>;
			record-size = <0x4000>;
			console-size = <0x4000>;
			pmsg-size = <0x100000>;
			ftrace-size = <0x4000>;
			ecc-size = <0x4000>;
		};
	};
	
	aliases {
		sdhc1 = "/soc/sdhci@7804000";
		serial0 = "/soc/serial@78af000";
		serial1 = "/soc/serial@78b0000";
		ethernet0 = "/soc/dp2";
		ethernet1 = "/soc/dp1";
	};
	
	chosen {
		bootargs = "console=ttyMSM0,115200,n8 rw init=/init";
		bootargs-append = " swiotlb=1 coherent_pool=2M ramoops.mem_address=0x4E500000 ramoops.mem_size=0x140000 ramoops.record_size=0x4000 ramoops.console_size=0x4000 ramoops.pmsg_size=0x100000 ramoops.ftrace_size=0x4000 ramoops.ecc=1";
		stdout-path = "serial0";
	};
	
	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";
		
		reset {
			label = "reset";
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			linux,input-type = <0x01>;
			debounce-interval = <0x3c>;
		};
		
		wps {
			label = "wps";
			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			linux,input-type = <0x01>;
			debounce-interval = <0x3c>;
		};
	};
	
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led0_2g>;
		pinctrl-names = "default";
		led_status: status {
			label = "white:status";
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		};
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
	phy-reset-gpio = <&tlmm 35 GPIO_ACTIVE_LOW>;
	phy-reset-active = <0x01>;
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	
	ethernet-phy@1d {
		compatible = "motorcomm,yt9215";
		reg = <0x1d>;
		mii-bus = <0x10>;
		switch = <0x0d 0x23 0x00>;
		phy-addr = <0x1d>;
	};
};

&switch {
	status = "okay";
	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;
	
	qcom,port_phyinfo {
		port@0 {
			port_id = <0x01>;
			mdiobus = <&mdio0>;
			phy_address = <0x07>;
		};
		
		port@1 {
			port_id = <0x02>;
			forced-speed = <0x9c4>;
			forced-duplex = <0x01>;
			mdiobus = <&mdio1>;
		};
	};
};

&dp1 {
	status = "okay";
	phy-mode = "sgmii";
	label = "lan";
	nvmem-cells = <&macaddr_appsblenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&dp2 {
	status = "okay";
	phy-mode = "sgmii";
	label = "wan";
	nvmem-cells = <&macaddr_appsblenv_ethaddr 1>;
	nvmem-cell-names = "mac-address";
};

&sleep_clk {
	clock-frequency = <0x7d00>;
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&uart_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&tlmm {
	mdio1_pins: mdio-state {
		phandle = <0x0c>;
		
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		
		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
	
	// phy_led_pins
	gephy_led_pin: gephy-led-pins {
		pins = "gpio46";
		function = "led0";
		drive-strength = <8>;
		bias-pull-down;
	};
	
	led0_2g: led-2g-pins {
		pins = "gpio30";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
		output-low;
	};
	
	// i2c_pins
	i2c_scl: i2c-pins {
		pins = "gpio25";
		function = "blsp2_i2c1";
		drive-strength = <0x08>;
		bias-disable;
	};
	
	i2c_sda: i2c-pins {
		pins = "gpio24";
		function = "blsp2_i2c1";
		drive-strength = <0x08>;
		bias-disable;
	};
	
	button_pins: button-pins {
		pins = "gpio27", "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
	
	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
		
		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};
		
		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};
	
	uart_pins: uart0-state {
		pins =
		"gpio20",// RX
		"gpio21";// TX
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};
};

&q6_region {
	reg = <0x0 0x4b000000 0x0 0x3500000>;
};

&wifi {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x00 0x4c000000 0x4c000000 0x00 0x00>;
	qcom,caldb-addr = <0x00 0x4cf00000 0x00 0x00 0x00>;
	qcom,multipd_arch;
	qcom,board_id = <0x23>;
	memory-region = <&q6_ipq5018_data>;
};

&wifi1 {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x00 0x4d100000 0x4cf00000 0x00 0x00>;
	qcom,caldb-addr = <0x00 0x4e000000 0x00 0x00 0x00>;
	qcom,caldb-size = <0x500000>;
	qcom,board_id = <0x60>;
	qcom,multipd_arch;
	memory-region = <&q6_qcn6122_data1>;
};
