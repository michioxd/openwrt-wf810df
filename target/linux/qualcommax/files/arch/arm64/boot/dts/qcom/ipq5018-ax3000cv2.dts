/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "FPT AX3000CV2";
	compatible ="fpt,ax3000cv2", "qcom,ipq5018";
	
	aliases {
		serial0 = &blsp1_uart1;
		
		ethernet0 = &dp1;
		ethernet1 = &dp2;
		
		led-boot = &led_red;
		led-failsafe = &led_red;
		led-running = &led_white;
		led-upgrade = &led_red;
	};
	
	chosen {
		bootargs-append = " swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};
	
	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";
		
		reset {
			label = "reset";
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			linux,input-type = <0x01>;
			debounce-interval = <0x3c>;
		};
		
		mesh {
			label = "mesh";
			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			linux,input-type = <0x01>;
			debounce-interval = <0x3c>;
		};
	};
	
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";
		
		led_red: led-red {
			label = "red:system";
			gpio = <&tlmm 30 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		
		led_white: led-white {
			label = "white:system";
			gpio = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		};
	};
};

&xo_clk {
	clock-frequency = <0x16e3600>;
};

&sleep_clk {
	clock-frequency = <0x7d00>;
};

&tsens {
	nvmem-cells = <0x53>;
	nvmem-cell-names = "calib";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
	
	yt9215: switch@1d {
		compatible = "motorcomm,yt921x";
		reg = <29>;
		switchid = <0>;
		
		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>; /* 10ms */
		reset-deassert-us = <50000>; /* 50ms */
		
		mdio {
			#address-cells = <1>;
			#size-cells = <0>;
			
			sw_phy0: phy@0 {
				reg = <0x0>;
			};
			
			sw_phy1: phy@1 {
				reg = <0x1>;
			};
			
			sw_phy2: phy@2 {
				reg = <0x2>;
			};
		};
		
		ports {
			// MAC0 -> Phy0 -> LAN1
			port@0 {
				reg = <0>;
				label = "lan1";
				phy-handle = <&sw_phy0>;
			};
			
			// MAC1 -> Phy1 -> LAN2
			port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&sw_phy1>;
			};
			
			// MAC2 -> Phy2 -> LAN3
			port@2 {
				reg = <2>;
				label = "lan3";
				phy-handle = <&sw_phy2>;
			};
			
			port@8 {
				reg = <8>;
				phy-mode = "2500base-x";
				
				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};
		};
	};
};

&switch {
	status = "okay";
	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;
	
	qcom,port_phyinfo {
		port@0 {
			port_id = <0x01>;
			mdiobus = <&mdio0>;
			phy_address = <0x07>;
		};
		
		port@1 {
			port_id = <0x02>;
			forced-speed = <0x9c4>;
			forced-duplex = <0x01>;
			mdiobus = <&mdio1>;
		};
	};
};

// MAC0 --- GE Phy (internal)
&dp1 {
	status = "okay";
	
	label = "wan";
	nvmem-cells = <&macaddr_appsblenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

// MAC1 ---SGMII---> YT9215 Phy
&dp2 {
	status = "okay";
	label = "lan";
	phy-mode = "2500base-x";
	phy-handle = <&yt9215>;
	nvmem-cells = <&macaddr_appsblenv_ethaddr 1>;
	nvmem-cell-names = "mac-address";
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&uart_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_nand {
	status = "okay";
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	
	nandcs@0 {
		compatible = "qcom,nandcs";
		reg = <0>;
		
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;
		
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			
			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x80000>;
				read-only;
			};
			
			partition@80000 {
				label = "0:MIBIB";
				reg = <0x80000 0x80000>;
				read-only;
			};
			
			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x100000 0x40000>;
				read-only;
			};
			
			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x140000 0x40000>;
				read-only;
			};
			
			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x100000>;
				read-only;
			};
			
			partition@280000 {
				label = "0:QSEE_1";
				reg = <0x280000 0x100000>;
				read-only;
			};
			
			partition@380000 {
				label = "0:DEVCFG";
				reg = <0x380000 0x40000>;
				read-only;
			};
			
			partition@3c0000 {
				label = "0:DEVCFG_1";
				reg = <0x3c0000 0x40000>;
				read-only;
			};
			
			partition@400000 {
				label = "0:CDT";
				reg = <0x400000 0x40000>;
				read-only;
			};
			
			partition@440000 {
				label = "0:CDT_1";
				reg = <0x440000 0x40000>;
				read-only;
			};
			
			partition@480000 {
				label = "0:APPSBLENV";
				reg = <0x480000 0x80000>;
				
				nvmem-layout {
					compatible = "u-boot,env";
					
					macaddr_appsblenv_ethaddr: ethaddr {
						#nvmem-cell-cells = <1>;
					};
					
					serial_number: AeiBoardSerialNumber {
						#nvmem-cell-cells = <1>;
					};
					
					model_name: modelname {
						#nvmem-cell-cells = <1>;
					};
				};
			};
			
			partition@500000 {
				label = "0:APPSBL";
				reg = <0x500000 0x140000>;
				read-only;
			};
			
			partition@640000 {
				label = "0:APPSBL_1";
				reg = <0x640000 0x140000>;
				read-only;
			};
			
			art: partition@780000 {
				label = "0:ART";
				reg = <0x780000 0x100000>;
				read-only;
			};
			
			partition@880000 {
				label = "0:TRAINING";
				reg = <0x880000 0x80000>;
				read-only;
			};
			
			partition@900000 {
				label = "APPSBLENV_1";
				reg = <0x900000 0x80000>;
				read-only;
			};
			
			partition@980000 {
				label = "ART_1";
				reg = <0x980000 0x100000>;
				read-only;
			};
			
			partition@a80000 {
				label = "TRAINING_1";
				reg = <0xa80000 0x80000>;
				read-only;
			};
			
			partition@b00000 {
				label = "cert";
				reg = <0xb00000 0x100000>;
				read-only;
			};
			
			partition@c00000 {
				label = "cert_1";
				reg = <0xc00000 0x100000>;
				read-only;
			};
			
			partition@d00000 {
				label = "rootfs";
				reg = <0xd00000 0xf300000>;
			};
		};
	};
};

&tlmm {
	mdio1_pins: mdio_state {
		phandle = <0x0c>;
		
		mdc {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		
		mdio {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
	
	leds_pins: leds_pins {
		led_white {
			pins = "gpio46";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		
		led_red {
			pins = "gpio30";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
	
	button_pins: button_pins {
		pins = "gpio27", "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
	
	qpic_pins: qpic_state {
		clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
		
		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};
		
		data {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};
	
	i2c_pins: i2c_pins {
		i2c_scl {
			pins = "gpio25";
			function = "blsp2_i2c1";
			drive-strength = <0x08>;
			bias-disable;
		};
		
		i2c_sda {
			pins = "gpio26";
			function = "blsp2_i2c1";
			drive-strength = <0x08>;
			bias-disable;
		};
	};
	
	uart_pins: uart0_state {
		pins = "gpio20","gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
	
	blsp0_spi_pins {
		pins = "gpio10", "gpio11", "gpio12", "gpio13";
		function = "blsp0_spi1";
		drive-strength = <0x02>;
		bias-disable;
	};
	
	qspi_nand_pins {
		phandle = <0x19>;
		
		qspi_clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <0x08>;
			bias-disable;
		};
		
		qspi_cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <0x08>;
			bias-disable;
		};
		
		qspi_data {
			pins = "gpio4\0gpio5\0gpio6\0gpio7";
			function = "qspi_data";
			drive-strength = <0x08>;
			bias-disable;
		};
	};
	
	pwm_pinmux {
		mux_1 {
			pins = "gpio0";
			function = "pwm10";
			drive-strength = <0x08>;
		};
		
		mux_2 {
			pins = "gpio1";
			function = "pwm20";
			drive-strength = <0x08>;
		};
		
		mux_3 {
			pins = "gpio45";
			function = "pwm3";
			drive-strength = <0x08>;
		};
	};
};

&q6v5_wcss {
	boot-args = <0x01 0x04 0x03 0x0f 0x00 0x00 0x02 0x04 0x02 0x12 0x00 0x00>;
};

&wifi {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-calibration-variant = "FPT-AX3000CV2";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,ath11k-calibration-variant = "FPT-AX3000CV2";
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
